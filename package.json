{
  "name": "andrechaves.me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal craft-flex site for André de Moraes Chaves — Hefesto Software House",
  "scripts": {
    "postinstall": "node scripts/workers-ci-build.mjs",
    "predev": "node scripts/fetch-medium.mjs",
    "dev": "vite-react-ssg dev",
    "prebuild": "node scripts/fetch-medium.mjs",
    "build": "vite-react-ssg build && node scripts/verify-assets.mjs",
    "verify-assets": "node scripts/verify-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-medium": "node scripts/fetch-medium.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "13.0.0",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^6.30.1",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fast-xml-parser": "5.10.1",
    "jsdom": "30.0.1",
    "sanitize-html": "2.17.7",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vite": "8.2.1",
    "vite-react-ssg": "0.9.2",
    "vitest": "4.1.10",
    "wrangler": "^4.20.0"
  },
  "overrides": {
    "three": "0.185.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
